{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Admin": {
    "Emails": [],
    "RequireConfirmedEmail": true
  },
  "RateLimits": {
    "Auth": { "PermitLimit": 20, "Window": "00:01:00" },
    "Import": { "PermitLimit": 10, "Window": "00:01:00" },
    "Writes": { "PermitLimit": 120, "Window": "00:01:00" }
  }
}

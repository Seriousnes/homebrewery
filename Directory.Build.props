<Project>
  <!-- Shared settings for every .NET project under src/ and tests/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One user-secrets store shared by every project: %APPDATA%/Microsoft/UserSecrets/homebrewery -->
    <UserSecretsId>homebrewery</UserSecretsId>
    <!--
      NuGet audit advisories (NU1901-NU1904) stay visible as warnings but do not fail the build,
      so a newly published CVE doesn't break unrelated work. Fix them by bumping or pinning the
      package in Directory.Packages.props.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>

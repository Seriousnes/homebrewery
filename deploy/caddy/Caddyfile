# Local routing for `docker compose up` (see docker-compose.yml and CLAUDE.md "Development guidelines").
# One origin for the browser: API paths go to ASP.NET Core, everything else (the SPA, Vite's module
# graph and its HMR websocket) goes to the Vite dev server. Websocket upgrades pass through
# reverse_proxy without extra configuration, and the incoming Host header is kept, so the API's
# same-origin checks and Vite's host check both see the browser's origin (e.g. localhost:8080).
#
# Environment (set in docker-compose.yml / compose.prod.yml):
#   HB_HTTP_PORT      port Caddy listens on, inside and outside the container (default 8080)
#   HB_API_UPSTREAM   /api, /share, /openapi, /healthz (and /healthz/live, /healthz/ready)
#                     (dev: api:8080, production image: app:8080)
#   HB_WEB_UPSTREAM   everything else                   (dev: web:5173, production image: app:8080)
#
# The container runs `caddy run --watch`, so edits to this file are picked up without a restart.
{
	# Local development only: plain HTTP, no certificates.
	auto_https off
}

# No host name in the address: the site answers localhost, 127.0.0.1 or any other name alike.
http://:{$HB_HTTP_PORT:8080} {
	@api path /api /api/* /share /share/* /openapi /openapi/* /healthz /healthz/*

	handle @api {
		reverse_proxy {$HB_API_UPSTREAM:api:8080}
	}

	handle {
		reverse_proxy {$HB_WEB_UPSTREAM:web:5173}
	}
}

# Settings for deploy/compose.external-db.yml (docs/operations.md "Managed PostgreSQL").
# Copy to deploy/external-db.env (git-ignored), fill in, then:
#   docker compose -f deploy/compose.external-db.yml --env-file deploy/external-db.env run --rm app migrate
#   docker compose -f deploy/compose.external-db.yml --env-file deploy/external-db.env up -d --wait

# Image: homebrewery:local is what `docker compose ... build` makes from this repository.
HB_IMAGE=homebrewery:local

# The app's database connection (Npgsql syntax). Put the server's CA certificate in deploy/db-certs/root.crt.
#   SSL Mode=VerifyFull   encrypt and check the certificate and the host name (recommended)
#   SSL Mode=VerifyCA     encrypt and check the certificate only
#   SSL Mode=Require      encrypt without checking the certificate (no protection against a man in the middle)
# Quote nothing here: docker compose passes the value through as is.
HB_CONNECTION_STRING=Host=db.example.com;Port=5432;Database=homebrewery;Username=homebrewery_app;Password=change-me;SSL Mode=VerifyFull;Root Certificate=/etc/homebrewery/db-certs/root.crt

# false (default): the app refuses to start while migrations are pending; run `migrate` (above) on every upgrade.
# true: the app migrates on start (its role then needs the rights to change the schema).
HB_MIGRATE_ON_STARTUP=false

# Where the app listens on this machine; point your TLS proxy at it.
HB_BIND=127.0.0.1
HB_HTTP_PORT=8080
# The proxy sends X-Forwarded-For/-Proto. Optionally trust only it (CIDR networks or addresses, comma separated).
HB_FORWARDED_HEADERS=true
HB_KNOWN_NETWORKS=
HB_KNOWN_PROXIES=

# Accounts that get the Admin role when they register or sign in (comma separated).
HB_ADMIN_EMAILS=

# Default log level (Trace, Debug, Information, Warning, Error, Critical, None).
HB_LOG_LEVEL=Information

# The backup service's connection (libpq). A read-only role is enough for pg_dump; restores need the owner.
HB_PGHOST=db.example.com
HB_PGPORT=5432
HB_PGDATABASE=homebrewery
HB_PGUSER=homebrewery_app
HB_PGPASSWORD=change-me
HB_PGSSLMODE=verify-full
HB_PGSSLROOTCERT=/etc/homebrewery/db-certs/root.crt

# Backups: interval (seconds or a number with s, m, h, d), how many to keep, and where (named volume or host folder).
HB_BACKUP_INTERVAL=1d
HB_BACKUP_KEEP=7
HB_BACKUP_VOLUME=backups

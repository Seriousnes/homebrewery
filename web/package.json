{
  "name": "homebrewery-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Homebrewery WYSIWYG front end (React 19 + TipTap 3 + Vite).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "schema": "tsx scripts/schema-manifest.ts",
    "prebuild": "npm run --if-present schema",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run-playwright.mjs",
    "e2e:smoke": "node e2e/matrix/run-suite.mjs --project=chromium --grep=@smoke",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "api:types": "openapi-typescript ../shared/openapi.json -o src/api/schema.d.ts",
    "fidelity": "tsx scripts/fidelity-run.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-dropcursor": "3.31.3",
    "@tiptap/extension-gapcursor": "3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "clsx": "^2.1.1",
    "dedent": "^1.7.2",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^5.4.2",
    "lodash": "^4.18.1",
    "marked": "15.0.12",
    "marked-alignment-paragraphs": "^1.0.0",
    "marked-definition-lists": "^1.0.1",
    "marked-diagrams-markdeep": "^1.0.1",
    "marked-emoji": "^2.0.3",
    "marked-extended-tables": "^2.0.1",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-nonbreaking-spaces": "^1.0.1",
    "marked-smartypants-lite": "^1.0.3",
    "marked-subsuper-text": "^1.0.4",
    "nanoid": "^6.0.1",
    "openapi-fetch": "^0.17.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/less": "^3.0.8",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "marked-hbfm": "^1.0.1",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-prefix-selector": "^2.2.1",
    "postcss-selector-parser": "^7.1.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
